{
  "manifest_version": 3,
  "name": "ThreadsGo: подключение профиля",
  "version": "1.0.0",
  "description": "Безопасно подключает открытый профиль Threads к ThreadsGo в один клик.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://www.threads.net/*",
    "https://threads.net/*",
    "https://www.threads.com/*",
    "https://threads.com/*",
    "https://threadsgo.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://threadsgo.ru/*", "https://www.threadsgo.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ThreadsGo",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
